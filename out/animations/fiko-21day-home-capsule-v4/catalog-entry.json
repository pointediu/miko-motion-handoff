    {
      "title": "触发与交互",
      "rows": [
        [
          "首次进入",
          "未展开态停留 600ms → 展开 → 停留 2.2 秒 → 自动收起；只演示一轮。"
        ],
        [
          "点击胶囊",
          "随时展开 / 收起；连续点击从当前画面接续，不跳回起点。"
        ],
        [
          "重播",
          "使用页面上方「重播 / 刷新」；Esc 可收起。"
        ]
      ]
    },
    {
      "title": "展开与收起",
      "rows": [
        [
          "展开 520ms",
          "宽度 60→137→134pt，右边缘 x332 固定；数字持续可见，局部 x34→30。"
        ],
        [
          "标签",
          "内外层0ms同时开始，380ms一起达到峰值，520ms同时落定；内层宽度=79×(外层宽度−60)/74。"
        ],
        [
          "收起 360ms",
          "内外层按同一进度同步收回，标题同步隐去；火苗与27始终保留。"
        ]
      ]
    },
    {
      "title": "原稿尺寸与颜色",
      "rows": [
        [
          "展开态",
          "61:18617 / 61:20685；134 × 36pt，圆角14，白底、1pt 黑色8%描边。"
        ],
        [
          "内嵌浅蓝底",
          "x52 / y3，79 × 30pt，圆角12；rgba(228,239,255,0.8)。"
        ],
        [
          "标题",
          "x63 / y7，58 × 22pt；使用原稿素材。"
        ]
      ]
    },
    {
      "title": "SwiftUI 实现",
      "rows": [
        [
          "参数",
          "HomeCapsuleV4Parameters.swift；时间秒、距离pt，JSON以ms计。"
        ],
        [
          "文字图片",
          "原图含白底；Web 使用 multiply，SwiftUI Image 使用 .blendMode(.multiply)，与浅蓝底在同一合成组。"
        ],
        [
          "交互",
          "统一时钟，点击从当前pose接续；数字不消失。"
        ],
        [
          "减少动态效果",
          "直接切换布局，120ms 淡入标题与浅蓝底。"
        ]
      ]
    }
